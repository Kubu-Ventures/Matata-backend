# Version control
.git
.gitignore

# Environment — never bake secrets into the image
.env
.env.*
!.env.example

# Tests — not needed at runtime
tests/
.pytest_cache/
coverage.xml
.coverage

# Documentation
docs/
*.md
!README.md

# Python artefacts
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/


# Infrastructure configs — not needed inside the app container.
# deploy/ also holds each county's generated secrets: never bake them in.
infra/
deploy/
docker-compose*.yml
Dockerfile

# IDE / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# CI
.github/
.trivyignore