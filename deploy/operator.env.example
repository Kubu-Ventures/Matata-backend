# Operator settings shared by every county on this server.
# Copy to deploy/operator.env (gitignored) and fill in before provisioning.
# The script sources this file with bash: quote any value containing spaces.

# Base domain. Each county is served at https://<slug>.<BASE_DOMAIN>, so point a
# wildcard DNS record (*.<BASE_DOMAIN>) or one A record per county at this server.
BASE_DOMAIN=matata.example.org

# Email Let's Encrypt uses for certificate expiry notices.
ACME_EMAIL=ops@example.org

# Path to the frontend repo's matata-app/ directory on this server.
FRONTEND_DIR=/opt/matata/Matata/matata-app

# Privy app shared by all counties (dashboard.privy.io). Add every county's
# https://<slug>.<BASE_DOMAIN> to the app's allowed origins, or logins fail.
PRIVY_APP_ID=
# The ES256 verification key on ONE line, in SINGLE quotes, with a literal \n
# between the PEM lines:
# PRIVY_VERIFICATION_KEY='-----BEGIN PUBLIC KEY-----\nMFkw...\n-----END PUBLIC KEY-----'
PRIVY_VERIFICATION_KEY=

# Photo screening (AWS Rekognition). Required: the county guide promises that
# photos are screened before storage. Pass --no-photo-screening to
# provision-county.sh to deploy without it (demos only).
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AI second opinion on photos: ollama (shared local model, no key) or anthropic.
VISION_PROVIDER=ollama
ANTHROPIC_API_KEY=

# Translation fallback for UI strings: libretranslate (shared, ~2 GB of
# language packs on first boot) or mock (static catalogues only).
TRANSLATION_PROVIDER=libretranslate

# Contact sent to Nominatim with geocoding requests (their usage policy).
GEOCODING_CONTACT=ops@example.org
