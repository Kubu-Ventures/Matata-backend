# =============================================================================
# CrisisMap Backend — Environment Variables Reference
# =============================================================================
# Copy this file to .env and fill in values before starting the application.
# Never commit .env to version control.
#
# Secret rotation schedule:
#   SECRET_KEY          — rotate every 90 days or on suspected compromise
#   JWT_SECRET_KEY      — rotate quarterly; see README.md for the procedure
#   PHONE_HASH_SALT     — rotate only on suspected compromise (rotation
#                         invalidates all stored phone hashes; requires a
#                         full re-hash migration)
#   AFRICASTALKING_API_KEY — rotate per Africa's Talking key-management policy
#   AWS credentials     — rotate via IAM; minimum 90-day cycle recommended
#   SMTP_PASSWORD       — rotate per your mail provider's policy
#
# Minimum entropy requirements:
#   SECRET_KEY          — 256-bit random value (32 bytes, base64-encoded)
#   JWT_SECRET_KEY      — 256-bit random value (32 bytes, base64-encoded)
#   PHONE_HASH_SALT     — minimum 32 random bytes, base64-encoded
#
# Generate a suitable value with:
#   python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# =============================================================================


# -----------------------------------------------------------------------------
# Core
# -----------------------------------------------------------------------------

# Runtime environment. One of: development | test | production
ENVIRONMENT=development

# 256-bit random secret used by FastAPI internals (e.g. signed cookies).
# Required. No default.
SECRET_KEY=

# PostgreSQL connection string.
# Required. No default.
DATABASE_URL=postgresql+asyncpg://crisismap:password@localhost:5432/crisismap

# Redis connection string. Used for rate limiting, caching, and Celery broker.
REDIS_URL=redis://localhost:6379

# Comma-separated list of allowed CORS origins.
# Wildcard (*) is never permitted and will fail the CI check.
ALLOWED_ORIGINS=http://localhost:3000

# Structured log level. One of: debug | info | warning | error
LOG_LEVEL=info

# Static bearer token for Prometheus /metrics scrape jobs.
# Leave empty to disable the metrics endpoint.
METRICS_TOKEN=


# -----------------------------------------------------------------------------
# JWT
# -----------------------------------------------------------------------------

# 256-bit random secret used to sign access and refresh tokens.
# Required in production. Rotate quarterly — see README.md.
JWT_SECRET_KEY=

# HMAC algorithm used for JWT signing.
JWT_ALGORITHM=HS256

# Lifetime of access tokens in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Lifetime of refresh tokens in days.
REFRESH_TOKEN_EXPIRE_DAYS=30


# -----------------------------------------------------------------------------
# Identifier hashing
# -----------------------------------------------------------------------------

# Minimum 32 random bytes, base64-encoded.
# Used to salt SHA-256 hashes of every login identifier (Privy DIDs, email
# addresses, and legacy phone numbers). The env var keeps its historical name.
# Rotation requires a full re-hash migration of stored values.
PHONE_HASH_SALT=


# -----------------------------------------------------------------------------
# Privy authentication (primary login — email OTP)
# -----------------------------------------------------------------------------
#
# Privy (https://privy.io) runs the email OTP flow on the frontend. The
# frontend then POSTs the resulting Privy tokens to POST /api/v1/auth/privy/verify,
# which verifies them and issues our own { token, refresh_token, role } pair.
#
# Dashboard setup (one time):
#   1. Create an app at https://dashboard.privy.io
#   2. User management > Authentication: enable Email, disable everything else.
#   3. User management > Authentication > Advanced: turn on
#      "Return user data in an identity token" (needed to resolve analyst roles).
#   4. Configuration > App settings: copy the App ID and the verification key.
#
# PRIVY_APP_ID must be byte-for-byte identical to the frontend's
# NEXT_PUBLIC_PRIVY_APP_ID, or every token fails the audience check.
# Leave both empty to disable Privy login (the verify endpoint then returns 401).
PRIVY_APP_ID=
# ES256 public key, PEM SPKI. Paste the whole block including the
# -----BEGIN PUBLIC KEY----- / -----END PUBLIC KEY----- lines (use "\n" or a
# quoted multi-line value, depending on how your process loads .env).
PRIVY_VERIFICATION_KEY=


# -----------------------------------------------------------------------------
# SMS gateway (legacy phone OTP — retained but dormant)
# -----------------------------------------------------------------------------
#
# Phone/SMS OTP (POST /auth/otp/send + /auth/otp/verify) is superseded by Privy
# email OTP above and is not used by the frontend. The code paths are kept
# working so SMS can be re-enabled as a fallback without a rebuild; the default
# console gateway costs nothing.

# SMS backend. One of: console | africastalking
# console — prints OTPs to stdout; no network call (default for dev/CI).
SMS_GATEWAY=console

# Required only when SMS_GATEWAY=africastalking.
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
# Optional — registered sender ID or shortcode for your country's mobile networks.
# Kenya (Safaricom) rejects unregistered alphanumeric sender IDs.
# Set to your AT-assigned shortcode (e.g. 20880) or a registered alphanumeric ID.
# Leave empty to use Africa's Talking's default shared sender.
AFRICASTALKING_SENDER_ID=

# Voice OTP fallback — places an AT outbound call and reads the OTP via TTS.
# Enable when SMS delivery fails due to carrier restrictions.
AFRICASTALKING_VOICE_ENABLED=false
# AT-assigned virtual number for outbound calls (E.164 format, e.g. +254711082XXX).
# Required when AFRICASTALKING_VOICE_ENABLED=true.
AFRICASTALKING_VOICE_NUMBER=
# Publicly reachable HTTPS base URL of this server (no trailing slash).
# Required when AFRICASTALKING_VOICE_ENABLED=true — AT fetches this to get TTS actions.
# Example: https://api.crisismap.matata.org
APP_PUBLIC_URL=


# -----------------------------------------------------------------------------
# Email delivery
# -----------------------------------------------------------------------------

# Email backend. One of: console | smtp
# console — prints emails to stdout; no network call (default for dev/CI).
EMAIL_PROVIDER=console

# SMTP settings — required only when EMAIL_PROVIDER=smtp.
# Dev default points at the Mailpit container (docker-compose service "mailpit").
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=False
SMTP_USE_STARTTLS=False

# From address used on all outgoing mail.
NOTIFICATION_FROM_EMAIL=noreply@crisismap.matata.org


# -----------------------------------------------------------------------------
# Content moderation
# -----------------------------------------------------------------------------

# Moderation backend. One of: mock | rekognition
# mock — no AWS required (default for dev/CI).
# rekognition — AWS Rekognition; Free Tier: 5 000 images/month.
MODERATION_PROVIDER=mock


# -----------------------------------------------------------------------------
# Object storage (S3 / MinIO / Cloudflare R2)
# -----------------------------------------------------------------------------

# Storage backend. One of: mock | s3
# mock — in-memory, no credentials needed (default for dev/CI).
# s3   — any S3-compatible service: AWS S3, self-hosted MinIO, Cloudflare R2.
STORAGE_BACKEND=mock


# -----------------------------------------------------------------------------
# MinIO (self-hosted S3-compatible storage — recommended for production)
# -----------------------------------------------------------------------------
# MinIO runs as a Docker service alongside the app (see docker-compose.prod.yml).
# No AWS account required. Set STORAGE_BACKEND=s3 and point S3_ENDPOINT_URL at
# the MinIO container to use it.
#
# Generate a strong password (min 20 chars) for MINIO_ROOT_PASSWORD:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
#
# After first boot, create the bucket once:
#   docker exec -it <minio-container> mc alias set local http://localhost:9000 \
#       "$MINIO_ROOT_USER" "$MINIO_ROOT_PASSWORD"
#   docker exec -it <minio-container> mc mb local/crisismap
MINIO_ROOT_USER=crisismap_admin
MINIO_ROOT_PASSWORD=


# -----------------------------------------------------------------------------
# AWS credentials (Rekognition and/or AWS S3)
# -----------------------------------------------------------------------------

# Required when MODERATION_PROVIDER=rekognition or STORAGE_BACKEND=s3 with AWS.
# When using self-hosted MinIO, set these to MINIO_ROOT_USER / MINIO_ROOT_PASSWORD.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=


# -----------------------------------------------------------------------------
# S3 / MinIO bucket
# -----------------------------------------------------------------------------

# Required when STORAGE_BACKEND=s3.
S3_BUCKET_NAME=crisismap

# Leave empty for AWS S3.
# For MinIO (production self-hosted): http://minio:9000
# For MinIO (local dev):              http://localhost:9000
S3_ENDPOINT_URL=


# -----------------------------------------------------------------------------
# GIS worker
# -----------------------------------------------------------------------------

# Geocoding provider. One of: nominatim | google | mock
# nominatim — free OpenStreetMap Nominatim API; no key required.
GEOCODING_PROVIDER=nominatim

# Required only when GEOCODING_PROVIDER=google.
GOOGLE_GEOCODING_API_KEY=

# Optional ISO 3166-1 alpha-2 country code to bias geocoding toward the
# deployment country (e.g. ke, ug, ng, ph, bd).
# Leave empty for global / multi-country deployments — no geographic filter
# is applied and all worldwide results are accepted.
GEOCODING_COUNTRY_CODE=

# Nearest-neighbour building search radius in metres (spec §9.2).
BUILDING_FOOTPRINT_SEARCH_RADIUS_M=30


# -----------------------------------------------------------------------------
# Celery
# -----------------------------------------------------------------------------

# Both default to REDIS_URL when left empty.
# In production, use separate Redis databases to isolate broker from cache:
#   CELERY_BROKER_URL=redis://redis:6379/0
#   CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=


# -----------------------------------------------------------------------------
# AI / Vision worker
# -----------------------------------------------------------------------------

# Vision backend. One of: mock | openai | anthropic
# mock — deterministic stub (default for dev/CI).
VISION_PROVIDER=mock

# Required only when VISION_PROVIDER=openai.
OPENAI_API_KEY=

# Required only when VISION_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# Alert ops when the AI Celery queue depth exceeds this value.
AI_PROCESSING_QUEUE_ALERT_DEPTH=500


# -----------------------------------------------------------------------------
# Confidence-based analyst routing  (responsible-AI floor)
# -----------------------------------------------------------------------------
#
# These thresholds control how the AI worker routes incoming reports to the
# analyst review queue.  The responsible-AI guidelines require that
# predictions below 60 % confidence receive mandatory human review before
# influencing any response decision.
#
# Review priority ladder:
#   critical — ai_confidence < AI_CONFIDENCE_CRITICAL_THRESHOLD
#              OR image quality < AI_QUALITY_CRITICAL_THRESHOLD
#   high     — ai_confidence < AI_CONFIDENCE_HIGH_PRIORITY_THRESHOLD
#              OR AI/reporter severity divergence detected
#   normal   — all other accepted reports
#   low      — high confidence, no divergence, good image quality
#
# Adjust these thresholds only after reviewing analyst throughput metrics.
# Lowering AI_CONFIDENCE_CRITICAL_THRESHOLD below 0.60 violates OCHA guidance.

# Reports below this confidence are "critical" (mandatory human review).
AI_CONFIDENCE_CRITICAL_THRESHOLD=0.60

# Reports in the 0.60-0.80 band, or with a divergence flag, are "high".
AI_CONFIDENCE_HIGH_PRIORITY_THRESHOLD=0.80

# Images below this quality score are unusable; severity prediction is noise.
AI_QUALITY_CRITICAL_THRESHOLD=0.30


# -----------------------------------------------------------------------------
# Active-learning divergence calibration  (HITL feedback loop)
# -----------------------------------------------------------------------------
#
# The AI worker compares its severity prediction against analyst overrides
# to detect model drift.  When enough high-confidence feedback accumulates,
# GET /analyst/ai-accuracy auto-calibrates the divergence threshold and writes
# it to Redis.  The AI worker reads the calibrated value on every task run.
#
# Calibration audit history (last 100 entries) is stored in Redis at:
#   crisismap:ai:calibration_history

# Baseline divergence threshold used before Redis has a calibrated value.
# A report is flagged for analyst review when
#   abs(ai_severity - reporter_severity) / scale > threshold.
AI_DIVERGENCE_THRESHOLD_DEFAULT=0.70

# Minimum number of high-confidence (ai_confidence > 0.7) feedback entries
# required before a calibrated threshold is written to Redis.
# Below this count the sample is too small; the existing threshold is kept.
AI_DIVERGENCE_MIN_SAMPLE=30

# The AI worker logs a WARNING when the stored threshold has not been
# refreshed within this many days.  Indicates analyst throughput has dropped
# and GET /analyst/ai-accuracy should be called to recalibrate.
AI_DIVERGENCE_STALENESS_DAYS=7


# -----------------------------------------------------------------------------
# Duplicate detection
# -----------------------------------------------------------------------------

# Candidate reports must fall within +/-N hours of the incoming report's
# created_at to be considered potential duplicates.
# 72 h accommodates delayed offline submissions and slow cellular sync while
# preventing cross-event false positives (e.g. flood then earthquake).
DUPLICATE_TIME_WINDOW_HOURS=72


# -----------------------------------------------------------------------------
# Translation (multilingual error messages and UI strings)
# -----------------------------------------------------------------------------

# Translation backend. One of: libretranslate | argostranslate | mock
# libretranslate — calls a self-hosted LibreTranslate container (default).
#                  Runs on-VPS; no text leaves the deployment boundary.
# argostranslate  — offline fallback; requires pip install argostranslate
#                   and pre-installed language packages.
# mock            — deterministic stub for tests and CI only.
TRANSLATION_PROVIDER=libretranslate

# URL of the LibreTranslate service.
# In the Docker Compose network the service name resolves automatically.
# Development (docker-compose.yml):  http://libretranslate:5000  (add service if needed)
# Production  (docker-compose.prod.yml): http://libretranslate:5000  (included)
LIBRETRANSLATE_URL=http://libretranslate:5000

# API key for the LibreTranslate *public hosted* API at libretranslate.com.
# Leave empty (the default) for self-hosted instances — no key is required.
LIBRETRANSLATE_API_KEY=

# Default / fallback language code when Accept-Language negotiation yields
# no supported match.
DEFAULT_LANGUAGE=en


# -----------------------------------------------------------------------------
# Analyst / responder / admin authentication
# -----------------------------------------------------------------------------
#
# There is no separate analyst auth provider. Analysts, responders, and admins
# log in through the same Privy email OTP flow as reporters (see the Privy
# section above). Provisioned rows in the analyst_accounts table (created via
# POST /api/v1/auth/analyst/register, keyed by a salted hash of the email) tell
# POST /api/v1/auth/privy/verify to issue the stored elevated role instead of
# role=reporter. The CLI command `python -m app.cli.create_analyst` bootstraps
# the first admin.


# -----------------------------------------------------------------------------
# Dashboard
# -----------------------------------------------------------------------------

DASHBOARD_BASE_URL=https://crisismap.matata.org