# =============================================================================
# CrisisMap Backend — Environment Variables Reference
# =============================================================================
# Copy this file to .env and fill in values before starting the application.
# Never commit .env to version control.
#
# Secret rotation schedule:
#   SECRET_KEY          — rotate every 90 days or on suspected compromise
#   JWT_SECRET_KEY      — rotate quarterly; see README.md for the procedure
#   PHONE_HASH_SALT     — rotate only on suspected compromise (rotation
#                         invalidates all stored phone hashes; requires a
#                         full re-hash migration)
#   AFRICASTALKING_API_KEY — rotate per Africa's Talking key-management policy
#   AWS credentials     — rotate via IAM; minimum 90-day cycle recommended
#   SMTP_PASSWORD       — rotate per your mail provider's policy
#
# Minimum entropy requirements:
#   SECRET_KEY          — 256-bit random value (32 bytes, base64-encoded)
#   JWT_SECRET_KEY      — 256-bit random value (32 bytes, base64-encoded)
#   PHONE_HASH_SALT     — minimum 32 random bytes, base64-encoded
#
# Generate a suitable value with:
#   python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# =============================================================================


# -----------------------------------------------------------------------------
# Core
# -----------------------------------------------------------------------------

# Runtime environment. One of: development | test | production
ENVIRONMENT=development

# 256-bit random secret used by FastAPI internals (e.g. signed cookies).
# Required. No default.
SECRET_KEY=

# PostgreSQL connection string.
# Required. No default.
DATABASE_URL=postgresql+asyncpg://crisismap:password@localhost:5432/crisismap

# Redis connection string. Used for rate limiting, caching, and Celery broker.
REDIS_URL=redis://localhost:6379

# Comma-separated list of allowed CORS origins.
# Wildcard (*) is never permitted and will fail the CI check.
ALLOWED_ORIGINS=http://localhost:3000

# Structured log level. One of: debug | info | warning | error
LOG_LEVEL=info

# Static bearer token for Prometheus /metrics scrape jobs.
# Leave empty to disable the metrics endpoint.
METRICS_TOKEN=


# -----------------------------------------------------------------------------
# JWT
# -----------------------------------------------------------------------------

# 256-bit random secret used to sign access and refresh tokens.
# Required in production. Rotate quarterly — see README.md.
JWT_SECRET_KEY=

# HMAC algorithm used for JWT signing.
JWT_ALGORITHM=HS256

# Lifetime of access tokens in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Lifetime of refresh tokens in days.
REFRESH_TOKEN_EXPIRE_DAYS=30


# -----------------------------------------------------------------------------
# Phone hashing
# -----------------------------------------------------------------------------

# Minimum 32 random bytes, base64-encoded.
# Used to salt SHA-256 hashes of phone numbers and analyst email addresses.
# Rotation requires a full re-hash migration of stored values.
PHONE_HASH_SALT=


# -----------------------------------------------------------------------------
# SMS gateway
# -----------------------------------------------------------------------------

# SMS backend. One of: console | africastalking
# console — prints OTPs to stdout; no network call (default for dev/CI).
SMS_GATEWAY=console

# Required only when SMS_GATEWAY=africastalking.
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=


# -----------------------------------------------------------------------------
# Email delivery
# -----------------------------------------------------------------------------

# Email backend. One of: console | smtp
# console — prints emails to stdout; no network call (default for dev/CI).
EMAIL_PROVIDER=console

# SMTP settings — required only when EMAIL_PROVIDER=smtp.
# Dev default points at the Mailpit container (docker-compose service "mailpit").
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=False
SMTP_USE_STARTTLS=False

# From address used on all outgoing mail.
NOTIFICATION_FROM_EMAIL=noreply@crisismap.matata.org


# -----------------------------------------------------------------------------
# Content moderation
# -----------------------------------------------------------------------------

# Moderation backend. One of: mock | rekognition
# mock — no AWS required (default for dev/CI).
# rekognition — AWS Rekognition; Free Tier: 5 000 images/month.
MODERATION_PROVIDER=mock


# -----------------------------------------------------------------------------
# Object storage (S3 / MinIO / Cloudflare R2)
# -----------------------------------------------------------------------------

# Storage backend. One of: mock | s3
# mock — in-memory, no credentials needed (default for dev/CI).
# s3   — any S3-compatible service: AWS S3, self-hosted MinIO, Cloudflare R2.
STORAGE_BACKEND=mock


# -----------------------------------------------------------------------------
# MinIO (self-hosted S3-compatible storage — recommended for production)
# -----------------------------------------------------------------------------
# MinIO runs as a Docker service alongside the app (see docker-compose.prod.yml).
# No AWS account required. Set STORAGE_BACKEND=s3 and point S3_ENDPOINT_URL at
# the MinIO container to use it.
#
# Generate a strong password (min 20 chars) for MINIO_ROOT_PASSWORD:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
#
# After first boot, create the bucket once:
#   docker exec -it <minio-container> mc alias set local http://localhost:9000 \
#       "$MINIO_ROOT_USER" "$MINIO_ROOT_PASSWORD"
#   docker exec -it <minio-container> mc mb local/crisismap
MINIO_ROOT_USER=crisismap_admin
MINIO_ROOT_PASSWORD=


# -----------------------------------------------------------------------------
# AWS credentials (Rekognition and/or AWS S3)
# -----------------------------------------------------------------------------

# Required when MODERATION_PROVIDER=rekognition or STORAGE_BACKEND=s3 with AWS.
# When using self-hosted MinIO, set these to MINIO_ROOT_USER / MINIO_ROOT_PASSWORD.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=


# -----------------------------------------------------------------------------
# S3 / MinIO bucket
# -----------------------------------------------------------------------------

# Required when STORAGE_BACKEND=s3.
S3_BUCKET_NAME=crisismap

# Leave empty for AWS S3.
# For MinIO (production self-hosted): http://minio:9000
# For MinIO (local dev):              http://localhost:9000
S3_ENDPOINT_URL=


# -----------------------------------------------------------------------------
# GIS worker
# -----------------------------------------------------------------------------

# Geocoding provider. One of: nominatim | google | mock
# nominatim — free OpenStreetMap Nominatim API; no key required.
GEOCODING_PROVIDER=nominatim

# Required only when GEOCODING_PROVIDER=google.
GOOGLE_GEOCODING_API_KEY=

# Optional ISO 3166-1 alpha-2 country code to bias geocoding toward the
# deployment country (e.g. ke, ug, ng, ph, bd).
# Leave empty for global / multi-country deployments — no geographic filter
# is applied and all worldwide results are accepted.
GEOCODING_COUNTRY_CODE=

# Nearest-neighbour building search radius in metres (spec §9.2).
BUILDING_FOOTPRINT_SEARCH_RADIUS_M=30


# -----------------------------------------------------------------------------
# Celery
# -----------------------------------------------------------------------------

# Both default to REDIS_URL when left empty.
# In production, use separate Redis databases to isolate broker from cache:
#   CELERY_BROKER_URL=redis://redis:6379/0
#   CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=


# -----------------------------------------------------------------------------
# AI / Vision worker
# -----------------------------------------------------------------------------

# Vision backend. One of: mock | openai | anthropic
# mock — deterministic stub (default for dev/CI).
VISION_PROVIDER=mock

# Required only when VISION_PROVIDER=openai.
OPENAI_API_KEY=

# Required only when VISION_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# Alert ops when the AI Celery queue depth exceeds this value.
AI_PROCESSING_QUEUE_ALERT_DEPTH=500


# -----------------------------------------------------------------------------
# Translation (multilingual error messages and UI strings)
# -----------------------------------------------------------------------------

# Translation backend. One of: libretranslate | argostranslate | mock
# libretranslate — calls a self-hosted LibreTranslate container (default).
#                  Runs on-VPS; no text leaves the deployment boundary.
# argostranslate  — offline fallback; requires pip install argostranslate
#                   and pre-installed language packages.
# mock            — deterministic stub for tests and CI only.
TRANSLATION_PROVIDER=libretranslate

# URL of the LibreTranslate service.
# In the Docker Compose network the service name resolves automatically.
# Development (docker-compose.yml):  http://libretranslate:5000  (add service if needed)
# Production  (docker-compose.prod.yml): http://libretranslate:5000  (included)
LIBRETRANSLATE_URL=http://libretranslate:5000

# API key for the LibreTranslate *public hosted* API at libretranslate.com.
# Leave empty (the default) for self-hosted instances — no key is required.
LIBRETRANSLATE_API_KEY=

# Default / fallback language code when Accept-Language negotiation yields
# no supported match.
DEFAULT_LANGUAGE=en


# -----------------------------------------------------------------------------
# Supabase Auth  (analyst / responder / admin accounts)
# -----------------------------------------------------------------------------
#
# Supabase is used exclusively for analyst-tier authentication. Reporter flows
# (anonymous tokens, phone OTP) are unaffected and do not use Supabase.
#
# Leave all four values empty in development to disable analyst login.
# The legacy CLI provisioning command (python -m app.cli.create_analyst)
# remains available as a dev/bootstrap fallback when Supabase is not set.
#
# How to obtain these values:
#   1. Create a free project at https://supabase.com
#   2. Go to Project Settings → API
#      SUPABASE_URL             — "Project URL"
#      SUPABASE_ANON_KEY        — "anon public" key
#      SUPABASE_SERVICE_ROLE_KEY — "service_role secret" key (keep secret)
#   3. Go to Project Settings → API → JWT Settings
#      SUPABASE_JWT_SECRET      — "JWT Secret"
#
# Security notes:
#   - SUPABASE_SERVICE_ROLE_KEY must NEVER be exposed to the client/frontend.
#   - SUPABASE_JWT_SECRET is used server-side to verify analyst tokens.
#   - Rotate SUPABASE_JWT_SECRET via Supabase dashboard; existing sessions
#     will be invalidated immediately on rotation.
#   - For production Matata deployments, run a self-hosted Supabase instance
#     on Matata infrastructure to satisfy data sovereignty requirements.
#     Alternatively, replace with Azure AD SSO via Supabase OAuth2 providers.
#
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=


# -----------------------------------------------------------------------------
# Dashboard
# -----------------------------------------------------------------------------

DASHBOARD_BASE_URL=https://crisismap.matata.org