# =============================================================================
# CrisisMap / Matata Backend — environment variable reference
# =============================================================================
# Copy this file to .env and fill in every value before running locally.
# .env is excluded from version control via .gitignore.
#
# All variables are read by pydantic-settings (app/core/config.py).
# No os.environ calls appear anywhere in the application code.
# =============================================================================

# -----------------------------------------------------------------------------
# Core
# -----------------------------------------------------------------------------

# Runtime environment.  Controls log format (JSON vs human-readable) and
# certain safety assertions.
# Allowed: development | test | production
ENVIRONMENT=development

# Arbitrary secret used by Starlette's SessionMiddleware (if enabled) and as a
# general-purpose signing secret.  Minimum 32 random bytes, hex-encoded.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Async PostgreSQL connection string.  PostGIS extension must be enabled.
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://app_user:changeme@localhost:5432/crisismap

# Redis connection URL used for OTP storage, refresh tokens, denylist, and
# rate-limit counters.
REDIS_URL=redis://localhost:6379

# Comma-separated list of allowed CORS origins.
# Example: http://localhost:3000,https://crisismap.example.com
ALLOWED_ORIGINS=http://localhost:3000

# Logging verbosity.  Allowed: debug | info | warning | error | critical
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# JWT — access and refresh token signing
# -----------------------------------------------------------------------------

# Primary signing secret for all JWTs.
# MUST be at minimum 64 random bytes, base64-encoded.
# Generate with: python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(64)).decode())"
JWT_SECRET_KEY=

# HMAC algorithm used to sign JWTs.  Do not change unless you also rotate all
# existing tokens and update the verification logic.
JWT_ALGORITHM=HS256

# Lifetime of an access token in minutes.  Applies to all roles.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Lifetime of a refresh token in days.
REFRESH_TOKEN_EXPIRE_DAYS=30

# -----------------------------------------------------------------------------
# Phone / identifier hashing
# -----------------------------------------------------------------------------

# Salt prepended to phone numbers (and analyst e-mail addresses) before
# SHA-256 hashing.  Prevents rainbow-table attacks against stored hashes.
# MUST be minimum 32 random bytes, base64-encoded.  Changing this value
# invalidates all existing hashed identifiers — treat it like a root secret.
# Generate with: python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
PHONE_HASH_SALT=

# -----------------------------------------------------------------------------
# SMS gateway
# -----------------------------------------------------------------------------

# Which SMS backend to use.
# Allowed: console | africastalking
#   console        — prints OTP to stdout; safe for development and CI
#   africastalking — production SMS via Africa's Talking API
SMS_GATEWAY=console

# Africa's Talking credentials — required only when SMS_GATEWAY=africastalking
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
STORAGE_BACKEND=s3

S3_ENDPOINT_URL=http://localhost:9000

S3_BUCKET_NAME=crisismap

AWS_ACCESS_KEY_ID=minioadmin

AWS_SECRET_ACCESS_KEY=minioadmin

AWS_REGION=us-east-1

# ── AI / Vision worker ─────────────────────────────────────────────────────
VISION_PROVIDER=mock           # mock | openai | anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_PROCESSING_QUEUE_ALERT_DEPTH=500